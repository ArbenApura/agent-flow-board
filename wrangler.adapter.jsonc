{
	// ONLY FOR THE BUILD: TELLS adapter-cloudflare WHERE TO WRITE THE APP'S WORKER SO IT NEVER OVERWRITES cloudflare/worker.ts.
	// The deployment itself is wrangler.jsonc, whose entry (cloudflare/worker.ts) imports the file this one names.
	"name": "agent-flow-board",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" }
}

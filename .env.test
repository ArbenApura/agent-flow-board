# Values for the local build preview that the browser checks and UI shots use. Nothing here is a secret.
# A real deployment sets its own values (see .env.example) and never uses these.
AFB_BASE_URL=http://localhost:5180
BETTER_AUTH_SECRET=local-preview-secret-not-for-deployment-0123456789
AFB_AUTO_MIGRATE=1
EMAIL_PROVIDER=log
AFB_OUTBOX_FILE=.afb/outbox.jsonl
AFB_PWNED_CHECK=0
AFB_RATE_LIMIT=0
AFB_ENABLE_GALLERY=1
AFB_MAIL_FAIL_PATTERN=^mailfail-
AFB_SEED_DEMO=1
AFB_STORAGE_DIR=.afb/preview-files

# Browser check secrets are sealed with this throwaway master key (ADR-024). A deployment sets its own.
AFB_MASTER_KEY=local-preview-master-key-not-for-deployment-0123456789

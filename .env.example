# Copy to .env and fill in. Every variable is described in src/env.ts, and a missing required one stops the app at start.
AFB_BASE_URL=https://board.example.com
BETTER_AUTH_SECRET=
# PostgreSQL as the app_runtime role. We use Supabase's session pooler (port 5432, user app_runtime.<project ref>). Leave empty for a local PGlite folder (offline work and tests only).
DATABASE_URL=
# PostgreSQL as the migration owner, for the db command and AFB_AUTO_MIGRATE.
DATABASE_OWNER_URL=
EMAIL_PROVIDER=resend
EMAIL_FROM=board@example.com
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

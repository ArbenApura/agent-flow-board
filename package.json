{
	"name": "agent-flow-board",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cli": "esbuild scripts/db.ts scripts/server.ts --bundle --platform=node --format=esm --packages=external --outdir=cli --out-extension:.js=.mjs --log-level=warning",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:packages": "tsc -p packages/runner/tsconfig.json && tsc -p importer/tsconfig.json && tsc -p scripts/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:checks": "playwright test",
		"perf": "node tests/perf/run.mjs",
		"ui-shots": "tsx tests/ui-shots/run.ts",
		"db": "tsx scripts/db.ts",
		"db:rename-refs": "tsx scripts/rename-item-refs.ts",
		"db:local:rename-refs": "cross-env DATABASE_URL=postgres://postgres:localpostgrespassword@127.0.0.1:5433/afb AFB_ALLOW_RENAME_REMOTE=1 tsx scripts/rename-item-refs.ts",
		"db:up": "docker compose -f deploy/local/compose.yaml up -d --wait",
		"db:down": "docker compose -f deploy/local/compose.yaml down",
		"db:local:reset": "docker compose -f deploy/local/compose.yaml down -v && yarn db:up && yarn db:local:migrate",
		"db:local:migrate": "cross-env DATABASE_URL=postgres://postgres:localpostgrespassword@127.0.0.1:5433/afb AFB_RUNTIME_PASSWORD=localruntimepassword tsx scripts/db.ts migrate",
		"dev:local": "cross-env DATABASE_URL=postgres://app_runtime:localruntimepassword@127.0.0.1:5433/afb DATABASE_OWNER_URL=postgres://postgres:localpostgrespassword@127.0.0.1:5433/afb AFB_BASE_URL=http://localhost:5180 AFB_AUTO_MIGRATE=1 AFB_SEED_DEMO=1 vite dev",
		"server": "tsx scripts/server.ts",
		"import:hapr": "tsx importer/cli.ts",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.11",
		"embedded-postgres": "18.4.0-beta.17",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "yarn@4.18.1",
	"dependencies": {
		"@lucide/svelte": "^1.57.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@opentelemetry/api": "^1.9.1",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.7.7",
		"cookie": "^2.0.1",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"markdown-it": "^15.0.2",
		"nodemailer": "^10.1.1",
		"pg": "^8.23.1",
		"pg-boss": "^12.38.0",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.7"
	},
	"dependenciesMeta": {
		"@embedded-postgres/darwin-arm64": {
			"built": true
		},
		"@embedded-postgres/darwin-x64": {
			"built": true
		},
		"@embedded-postgres/linux-arm64": {
			"built": true
		},
		"@embedded-postgres/linux-x64": {
			"built": true
		},
		"@embedded-postgres/windows-x64": {
			"built": true
		},
		"esbuild": {
			"built": true
		}
	},
	"resolutions": {
		"@playwright/test": "1.64.0",
		"playwright": "1.64.0",
		"playwright-core": "1.64.0",
		"@sveltejs/kit": "3.0.1"
	}
}

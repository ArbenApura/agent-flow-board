# Copy to .env next to compose.yaml and fill in every line that has no value. Never commit the .env file.
# Make each secret with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-40     (letters and digits only where noted)

# Where people reach the board, and the same name without the scheme for the proxy
AFB_BASE_URL=https://board.example.com
AFB_DOMAIN=board.example.com

# A second hostname for mockups (same server, its own DNS record). Leave both empty to serve mockups from the board host, for local development only
MOCKUP_ORIGIN=https://mockups.board.example.com
MOCKUP_DOMAIN=mockups.board.example.com

# Letters and digits only: they are written into SQL by the first start of the database
POSTGRES_PASSWORD=
AFB_OWNER_PASSWORD=
AFB_BACKUP_DB_PASSWORD=
# 16 or more of letters, digits and _ . ~ -  (the migration step gives the app_runtime role this password)
AFB_RUNTIME_PASSWORD=

# At least 32 characters each. BETTER_AUTH_SECRET signs sessions. BACKUP_KEY encrypts every backup: lose it and the backups cannot
# be read, so keep a copy somewhere else. AFB_MASTER_KEY wraps the keys that seal test account passwords.
BETTER_AUTH_SECRET=
BACKUP_KEY=
AFB_MASTER_KEY=

# Email. Without it nobody gets a verification or invitation mail. resend, postmark or smtp ("log" sends nothing: use it only to try the board).
EMAIL_PROVIDER=log
EMAIL_FROM=board@example.com
RESEND_API_KEY=
POSTMARK_TOKEN=
SMTP_URL=

# Optional: Google sign in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
